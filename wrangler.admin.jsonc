{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xinling-admin",
  "main": "./admin-worker.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./admin-site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
